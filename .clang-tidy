# Run as part of the build (see ENABLE_CLANG_TIDY in the root CMakeLists.txt) - any finding fails it.
# pro-type-member-init: a class field without an initializer stays indeterminate when nothing
# assigns it (e.g. a CLI11 flag that wasn't passed); init-variables: the same for locals.
Checks: '-*,cppcoreguidelines-pro-type-member-init,cppcoreguidelines-init-variables'
WarningsAsErrors: '*'
