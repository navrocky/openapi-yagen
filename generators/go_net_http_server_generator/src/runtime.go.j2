// Router is what RegisterXRoutes registers operations onto - *http.ServeMux satisfies it as-is. Pass
// your own implementation to wrap a mux (e.g. to record, instrument, or prefix every route).
type Router interface {
	HandleFunc(pattern string, handler func(http.ResponseWriter, *http.Request))
}

// Route describes one generated operation route: its HTTP method, its path template exactly as
// declared in the OpenAPI document (e.g. "/pets/{petId}"), its operationId (empty if the document
// doesn't declare one), and the OpenAPI tag it's grouped under.
type Route struct {
	Method      string
	Path        string
	OperationID string
	Tag         string
}

func parseString(s string) (string, error) { return s, nil }

func parseInt32(s string) (int32, error) {
	n, err := strconv.ParseInt(s, 10, 32)
	return int32(n), err
}

func parseInt64(s string) (int64, error) {
	return strconv.ParseInt(s, 10, 64)
}

func parseFloat32(s string) (float32, error) {
	n, err := strconv.ParseFloat(s, 32)
	return float32(n), err
}

func parseFloat64(s string) (float64, error) {
	return strconv.ParseFloat(s, 64)
}

func parseRFC3339(s string) (time.Time, error) {
	return time.Parse(time.RFC3339, s)
}

func convertParam[T any](raw string, field string, convert func(string) (T, error)) (T, error) {
	v, err := convert(raw)
	if err != nil {
		var zero T
		return zero, &models.ValidationError{Field: field, Message: fmt.Sprintf("is not a valid value: %v", err)}
	}
	return v, nil
}

func pathParamAs[T any](r *http.Request, name string, convert func(string) (T, error)) (T, error) {
	return convertParam(r.PathValue(name), name, convert)
}

func queryParamAs[T any](r *http.Request, name string, convert func(string) (T, error)) (*T, error) {
	if !r.URL.Query().Has(name) {
		return nil, nil
	}
	v, err := convertParam(r.URL.Query().Get(name), name, convert)
	if err != nil {
		return nil, err
	}
	return &v, nil
}

func requireQueryParamAs[T any](r *http.Request, name string, convert func(string) (T, error)) (T, error) {
	var zero T
	if !r.URL.Query().Has(name) {
		return zero, &models.ValidationError{Field: name, Message: "is required"}
	}
	return convertParam(r.URL.Query().Get(name), name, convert)
}

// OpenAPI 3's default array-typed query parameter serialization (`style: form, explode: true`):
// one repeated `name=` key per element, e.g. `?ids=1&ids=2`.
func queryParamListAs[T any](r *http.Request, name string, convert func(string) (T, error)) ([]T, error) {
	raws := r.URL.Query()[name]
	if raws == nil {
		return nil, nil
	}
	result := make([]T, 0, len(raws))
	for _, raw := range raws {
		v, err := convertParam(raw, name, convert)
		if err != nil {
			return nil, err
		}
		result = append(result, v)
	}
	return result, nil
}

func headerParamAs[T any](r *http.Request, name string, convert func(string) (T, error)) (*T, error) {
	values := r.Header.Values(name)
	if len(values) == 0 {
		return nil, nil
	}
	v, err := convertParam(values[0], name, convert)
	if err != nil {
		return nil, err
	}
	return &v, nil
}

func requireHeaderParamAs[T any](r *http.Request, name string, convert func(string) (T, error)) (T, error) {
	var zero T
	values := r.Header.Values(name)
	if len(values) == 0 {
		return zero, &models.ValidationError{Field: name, Message: "is required"}
	}
	return convertParam(values[0], name, convert)
}

func cookieParamAs[T any](r *http.Request, name string, convert func(string) (T, error)) (*T, error) {
	c, err := r.Cookie(name)
	if err != nil {
		return nil, nil
	}
	v, err := convertParam(c.Value, name, convert)
	if err != nil {
		return nil, err
	}
	return &v, nil
}

func requireCookieParamAs[T any](r *http.Request, name string, convert func(string) (T, error)) (T, error) {
	var zero T
	c, err := r.Cookie(name)
	if err != nil {
		return zero, &models.ValidationError{Field: name, Message: "is required"}
	}
	return convertParam(c.Value, name, convert)
}

// formFieldAs/requireFormFieldAs read a urlencoded or multipart request body field - Go's
// net/http parses either the same way once ParseMultipartForm has been called (it falls back to
// ParseForm for a non-multipart body), so one code path covers both request body encodings.
func formFieldAs[T any](r *http.Request, name string, convert func(string) (T, error)) (*T, error) {
	if err := r.ParseMultipartForm(32 << 20); err != nil && err != http.ErrNotMultipart {
		return nil, &models.ValidationError{Field: name, Message: fmt.Sprintf("invalid form body: %v", err)}
	}
	if !r.PostForm.Has(name) {
		return nil, nil
	}
	v, err := convertParam(r.PostForm.Get(name), name, convert)
	if err != nil {
		return nil, err
	}
	return &v, nil
}

func requireFormFieldAs[T any](r *http.Request, name string, convert func(string) (T, error)) (T, error) {
	var zero T
	if err := r.ParseMultipartForm(32 << 20); err != nil && err != http.ErrNotMultipart {
		return zero, &models.ValidationError{Field: name, Message: fmt.Sprintf("invalid form body: %v", err)}
	}
	if !r.PostForm.Has(name) {
		return zero, &models.ValidationError{Field: name, Message: "is required"}
	}
	return convertParam(r.PostForm.Get(name), name, convert)
}

// formFieldListAs reads a urlencoded or multipart body field declared as an array of
// primitive/enum items, sent as a repeated form key (e.g. `tags=a&tags=b` - OpenAPI's default
// `style: form, explode: true`, same convention queryParamListAs uses for array query parameters).
// nil, nil (not an error) if the key is entirely absent - "required" is enforced by the caller with
// the same explicit nil-check a required array query/header param already uses.
func formFieldListAs[T any](r *http.Request, name string, convert func(string) (T, error)) ([]T, error) {
	if err := r.ParseMultipartForm(32 << 20); err != nil && err != http.ErrNotMultipart {
		return nil, &models.ValidationError{Field: name, Message: fmt.Sprintf("invalid form body: %v", err)}
	}
	raws := r.PostForm[name]
	if raws == nil {
		return nil, nil
	}
	result := make([]T, 0, len(raws))
	for _, raw := range raws {
		v, err := convertParam(raw, name, convert)
		if err != nil {
			return nil, err
		}
		result = append(result, v)
	}
	return result, nil
}

// formFileAs reads an uploaded file part (a multipart `format: binary` field) as raw bytes - nil,
// nil if the part is absent, the same "nil represents absent" convention every other slice/map-typed
// field already uses (see types.js's isRefType) rather than a separate pointer wrapper.
func formFileAs(r *http.Request, name string) ([]byte, error) {
	if err := r.ParseMultipartForm(32 << 20); err != nil && err != http.ErrNotMultipart {
		return nil, &models.ValidationError{Field: name, Message: fmt.Sprintf("invalid form body: %v", err)}
	}
	file, _, err := r.FormFile(name)
	if err != nil {
		if errors.Is(err, http.ErrMissingFile) {
			return nil, nil
		}
		return nil, &models.ValidationError{Field: name, Message: fmt.Sprintf("invalid file: %v", err)}
	}
	defer file.Close()
	data, err := io.ReadAll(file)
	if err != nil {
		return nil, &models.ValidationError{Field: name, Message: fmt.Sprintf("invalid file: %v", err)}
	}
	return data, nil
}

func decodeJSONBody[T any](r *http.Request) (T, error) {
	var v T
	if err := json.NewDecoder(r.Body).Decode(&v); err != nil {
		var zero T
		return zero, &models.ValidationError{Field: "body", Message: fmt.Sprintf("invalid JSON: %v", err)}
	}
	return v, nil
}

// decodeOptionalJSONBody is decodeJSONBody's counterpart for a requestBody that isn't marked
// `required` - an absent (empty) body decodes to (nil, nil) instead of a decode error.
func decodeOptionalJSONBody[T any](r *http.Request) (*T, error) {
	data, err := io.ReadAll(r.Body)
	if err != nil {
		return nil, &models.ValidationError{Field: "body", Message: fmt.Sprintf("invalid JSON: %v", err)}
	}
	if len(data) == 0 {
		return nil, nil
	}
	var v T
	if err := json.Unmarshal(data, &v); err != nil {
		return nil, &models.ValidationError{Field: "body", Message: fmt.Sprintf("invalid JSON: %v", err)}
	}
	return &v, nil
}

// BinaryBody is a raw (non-JSON, non-form, non-text) request body, handed to the handler still
// unread - read it as a stream (it's an io.Reader), or call Bytes() to buffer it whole. Its
// Content-Type has already been checked against the media type the operation declares.
type BinaryBody struct {
	// ContentType is the request's media type, without parameters (e.g. "application/octet-stream").
	ContentType string
	// ContentLength is the request's declared body length, or -1 if unknown (chunked transfer).
	ContentLength int64
	// Header is the full set of request headers.
	Header http.Header

	w http.ResponseWriter
	r *http.Request
}

// Read reads the request body directly from the connection, without buffering it in memory.
func (b *BinaryBody) Read(p []byte) (int, error) { return b.r.Body.Read(p) }

// Limit caps how many bytes can still be read from the body: reading past n bytes fails with an
// *http.MaxBytesError (mapped to 413 by DefaultErrorHandler when returned from the handler) and
// closes the connection once the response is written. Call it before reading.
func (b *BinaryBody) Limit(n int64) { b.r.Body = http.MaxBytesReader(b.w, b.r.Body, n) }

// Bytes reads the whole remaining body into memory.
func (b *BinaryBody) Bytes() ([]byte, error) { return io.ReadAll(b) }

// UnsupportedMediaTypeError is returned when a raw request body's Content-Type doesn't match the
// media type the operation declares - mapped to 415 by DefaultErrorHandler.
type UnsupportedMediaTypeError struct {
	Expected string
	Actual   string
}

func (e *UnsupportedMediaTypeError) Error() string {
	return fmt.Sprintf("unsupported Content-Type %q, expected %q", e.Actual, e.Expected)
}

// mediaTypeMatches reports whether a request's media type satisfies a declared one, which may be a
// wildcard ("*/*" or "type/*").
func mediaTypeMatches(declared, actual string) bool {
	if declared == "*/*" {
		return true
	}
	if prefix, ok := strings.CutSuffix(declared, "/*"); ok {
		return strings.HasPrefix(actual, prefix+"/")
	}
	return declared == actual
}

func readBinaryBody(w http.ResponseWriter, r *http.Request, declaredMediaType string, required bool) (*BinaryBody, error) {
	if r.ContentLength == 0 {
		if required {
			return nil, &models.ValidationError{Field: "body", Message: "is required"}
		}
		return nil, nil
	}
	declared, _, err := mime.ParseMediaType(declaredMediaType)
	if err != nil {
		declared = strings.ToLower(declaredMediaType)
	}
	rawContentType := r.Header.Get("Content-Type")
	// RFC 9110 section 8.3: a body without a Content-Type may be treated as application/octet-stream.
	actual := "application/octet-stream"
	if rawContentType != "" {
		actual, _, err = mime.ParseMediaType(rawContentType)
		if err != nil {
			return nil, &UnsupportedMediaTypeError{Expected: declaredMediaType, Actual: rawContentType}
		}
	}
	if !mediaTypeMatches(declared, actual) {
		return nil, &UnsupportedMediaTypeError{Expected: declaredMediaType, Actual: rawContentType}
	}
	return &BinaryBody{ContentType: actual, ContentLength: r.ContentLength, Header: r.Header, w: w, r: r}, nil
}

// File is a raw (non-JSON, non-text) response body. Set Data for content already in memory, or
// Content to stream it; Content implementing io.Closer is closed once the response is sent.
type File struct {
	// Data is the whole response body, when already in memory. Takes precedence over Content.
	Data []byte
	// Content is streamed as the response body when Data is nil. For a 200 response, an
	// io.ReadSeeker (e.g. *os.File) is served via http.ServeContent: Range requests (206 Partial
	// Content), Content-Length, and If-Modified-Since/If-Range conditional requests are handled
	// automatically. Any other io.Reader is copied as-is.
	Content io.Reader
	// Name, if set, is sent as Content-Disposition: attachment; filename="Name".
	Name string
	// ModTime, if set, is sent as Last-Modified (and used for conditional requests).
	ModTime time.Time
	// ContentType overrides the media type the operation declares for this response.
	ContentType string
}

func writeFile(w http.ResponseWriter, r *http.Request, statusCode int, declaredMediaType string, f File) {
	content := f.Content
	if f.Data != nil {
		content = bytes.NewReader(f.Data)
	}
	if closer, ok := content.(io.Closer); ok {
		defer closer.Close()
	}
	contentType := f.ContentType
	if contentType == "" {
		contentType = declaredMediaType
		if strings.Contains(contentType, "*") {
			contentType = "application/octet-stream"
		}
	}
	w.Header().Set("Content-Type", contentType)
	if f.Name != "" {
		if disposition := mime.FormatMediaType("attachment", map[string]string{"filename": f.Name}); disposition != "" {
			w.Header().Set("Content-Disposition", disposition)
		}
	}
	if seeker, ok := content.(io.ReadSeeker); ok && statusCode == http.StatusOK {
		http.ServeContent(w, r, "", f.ModTime, seeker)
		return
	}
	if !f.ModTime.IsZero() {
		w.Header().Set("Last-Modified", f.ModTime.UTC().Format(http.TimeFormat))
	}
	w.WriteHeader(statusCode)
	if content != nil {
		io.Copy(w, content)
	}
}

func writeJSON(w http.ResponseWriter, statusCode int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(statusCode)
	json.NewEncoder(w).Encode(v)
}

// MissingAuthenticationError is returned when a securityScheme's credentials (bearer token /
// apiKey) are absent from the request - distinct from models.ValidationError, so DefaultErrorHandler
// maps it to 401 (you haven't authenticated), not 400 (your request is malformed).
type MissingAuthenticationError struct {
	msg string
}

func (e *MissingAuthenticationError) Error() string { return e.msg }

// RequireBearerToken extracts a bearer token from the given header for an `http`/`bearer`
// securityScheme, stripping a "Bearer " prefix if present.
func RequireBearerToken(r *http.Request, headerName string) (string, error) {
	raw := r.Header.Get(headerName)
	if raw == "" {
		return "", &MissingAuthenticationError{msg: fmt.Sprintf("missing required %q header", headerName)}
	}
	const prefix = "Bearer "
	if strings.HasPrefix(raw, prefix) {
		return strings.TrimPrefix(raw, prefix), nil
	}
	return raw, nil
}

// RequireAPIKey extracts an apiKey securityScheme's value from wherever its `in` says it lives.
func RequireAPIKey(r *http.Request, location, name string) (string, error) {
	var raw string
	switch location {
	case "header":
		raw = r.Header.Get(name)
	case "query":
		raw = r.URL.Query().Get(name)
	case "cookie":
		if c, err := r.Cookie(name); err == nil {
			raw = c.Value
		}
	default:
		return "", fmt.Errorf("unsupported apiKey location: %s", location)
	}
	if raw == "" {
		return "", &MissingAuthenticationError{msg: fmt.Sprintf("missing required apiKey %q (in: %s)", name, location)}
	}
	return raw, nil
}

// ErrorHandler decides how to respond when parameter parsing/validation, authentication, or a
// handler method itself returns an error.
type ErrorHandler func(w http.ResponseWriter, r *http.Request, err error)

// DefaultErrorHandler maps *models.ValidationError to 400, *MissingAuthenticationError to 401,
// *http.MaxBytesError (a BinaryBody read past its Limit) to 413, *UnsupportedMediaTypeError to 415,
// and anything else to 500.
func DefaultErrorHandler(w http.ResponseWriter, r *http.Request, err error) {
	var validationErr *models.ValidationError
	if errors.As(err, &validationErr) {
		http.Error(w, validationErr.Error(), http.StatusBadRequest)
		return
	}
	var authErr *MissingAuthenticationError
	if errors.As(err, &authErr) {
		http.Error(w, authErr.Error(), http.StatusUnauthorized)
		return
	}
	var maxBytesErr *http.MaxBytesError
	if errors.As(err, &maxBytesErr) {
		http.Error(w, maxBytesErr.Error(), http.StatusRequestEntityTooLarge)
		return
	}
	var mediaTypeErr *UnsupportedMediaTypeError
	if errors.As(err, &mediaTypeErr) {
		http.Error(w, mediaTypeErr.Error(), http.StatusUnsupportedMediaType)
		return
	}
	http.Error(w, "internal server error", http.StatusInternalServerError)
}
