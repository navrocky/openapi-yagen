{%- include "templates/_macros.ts.j2" -%}
{% if validateResponses -%}
{% for m in modelImports -%}
import { type {{ m }}, is{{ m }} } from "../models/{{ m }}{{ importExt }}";
{% endfor -%}
{% else -%}
{% for m in modelImports -%}
import type { {{ m }} } from "../models/{{ m }}{{ importExt }}";
{% endfor -%}
{% endif -%}
import { request } from "../runtime{{ importExt }}";
import type { ApiClientConfig } from "../runtime{{ importExt }}";

{{ docComment(tagDescription) }}export class {{ tagClass }} {
  constructor(private readonly config: ApiClientConfig) {}
{% for op in operations %}

{% if op.docComment %}  {{ op.docComment | indent(2) }}
{% endif %}  {{ op.name }}({% for p in op.pathParams %}{{ p.tsName }}: {{ p.tsType }}, {% endfor %}options: {
{% if op.optionsFields %}{% filter indent(4, true) %}{% for f in op.optionsFields %}{{ f.tsName }}{% if not f.required %}?{% endif %}: {{ f.tsType }};
{% endfor %}{% endfilter %}{% endif %}  }{% if not op.optionsRequired %} = {}{% endif %}): Promise<{{ op.response.tsType }}> {
    return request<{{ op.response.tsType }}>(this.config, {
{% filter indent(6, true) %}method: "{{ op.method }}",
path: `{{ op.pathExpr }}`,
{% if op.hasQueryParams %}query: {
{% for p in op.queryParams %}  {{ p.queryKeyLiteral }}: {% if p.arraySeparator %}options.{{ p.tsName }}?.join({{ toStringLiteral(p.arraySeparator) }}){% else %}options.{{ p.tsName }}{% endif %},
{% endfor %}},
{% endif %}{% if op.hasHeaderParams %}headers: {
{% for p in op.headerParams %}  {{ p.headerKeyLiteral }}: options.{{ p.tsName }},
{% endfor %}},
{% endif %}{% if op.hasBody %}body: options.body,
{% if op.body.encoding != "json" %}bodyEncoding: "{{ op.body.encoding }}",
{% endif %}{% if op.body.mediaType %}bodyContentType: "{{ op.body.mediaType }}",
{% endif %}{% endif %}signal: options.signal,
{% if op.authLiteral %}auth: {{ op.authLiteral }},
{% endif %}{% if op.response.variants %}responses: {
{% for v in op.response.variants %}  {{ v.statusCode }}: { encoding: "{{ v.encodingLiteral }}"{% if v.validatorExpr %}, validate: {{ v.validatorExpr }}{% endif %} },
{% endfor %}},
{% else %}{% if op.response.hasValidator %}validate: {{ op.response.validatorExpr }},
{% endif %}{% if op.response.encoding != "json" %}responseEncoding: "{{ op.response.encoding }}",
{% endif %}{% endif %}{% endfilter %}    });
  }
{% endfor %}
}
{% for op in operations %}{% if op.response.variants %}

/** One of `{{ tagClass }}.{{ op.name }}`'s success responses, told apart by `status`. */
export type {{ op.response.aliasName }} =
{% for v in op.response.variants %}{% if v.description %}{{ buildDocComment(v.description) | indent(2, true) }}
{% endif %}  | { status: {{ v.statusCode }}{% if v.hasBody %}; body: {{ v.tsType }}{% endif %} }{% if loop.is_last %};{% endif %}
{% endfor %}{% endif %}{% endfor %}
